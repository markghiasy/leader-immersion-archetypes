# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Any standard Postgres URL. The app uses node-postgres, so RDS, Aurora, a container,
# or a managed provider all work unchanged.
#   RDS      postgresql://user:pass@my-db.abc123.ap-southeast-2.rds.amazonaws.com:5432/quiz?sslmode=require
#   local    postgresql://quiz:quiz@localhost:5433/quiz     (see docker-compose.yml)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Absolute origin, no trailing slash. Invite links, QR codes and email buttons are built
# from this at render time — set it to the FINAL public origin before any QR is printed.
BASE_URL="http://localhost:3000"

# HTTP Basic Auth for /admin. With either unset, /admin returns 503 — it fails closed.
ADMIN_USER="admin"
ADMIN_PASS="change-me"

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Without RESEND_API_KEY the "email me my scorecard" section is hidden and the rest of
# the app works normally.
RESEND_API_KEY=""
EMAIL_FROM="Leader Archetype <noreply@yourdomain.com>"

# Extraction model for the conversational interview (lib/interview/extractor.ts and
# scripts/extraction-eval.ts). Only needed for that work — the quiz itself never calls a model.
ANTHROPIC_API_KEY=""

# TLS. For RDS, paste the contents of the regional CA bundle from
# https://truststore.pki.rds.amazonaws.com/ to get full certificate verification.
# Left unset, a URL containing sslmode=require still encrypts but does not verify.
DATABASE_CA_CERT=""

# Connection pool. Defaults suit both a long-lived container and a serverless instance;
# raise DB_POOL_MAX only alongside the database's own max_connections.
DB_POOL_MAX="5"
DB_POOL_IDLE_MS="10000"
DB_CONNECT_TIMEOUT_MS="10000"
